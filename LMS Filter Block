module lms_16tap (
    input  logic clk, rst,
    input  logic in_valid,
    input  logic signed [15:0] x_in,
    input  logic signed [15:0] d_in,
    output logic out_valid,
    output logic signed [15:0] y_out
);

    logic signed [15:0] x[0:15];
    logic signed [15:0] w[0:15];
    logic signed [31:0] y;
    logic signed [15:0] e;

    integer i;

    always_ff @(posedge clk or posedge rst) begin
        if (rst) begin
            for (i=0;i<16;i++) begin
                x[i] <= 0;
                w[i] <= 0;
            end
            out_valid <= 0;
        end else begin
            out_valid <= 0;

            if (in_valid) begin
                for (i=15;i>0;i--)
                    x[i] <= x[i-1];
                x[0] <= x_in;

                y = 0;
                for (i=0;i<16;i++) begin
                    y[i] <= w[i]*x[i];
               end
                for(i=0;i<8;i++) begin
                    sum[i]<=y[i]+y[2*i];
                end
               for(i=0;i<4;i++) begin
                    sum1[i]<=sum[i]+sum[2*i];
               end
               for(i=0;i<2;i++) begin
                    sum_final<=sum1[i]+sum2[i];
               end
                Y <=sum_final;
                e = d_in - (Y >>> 8);

                for (i=0;i<16;i++)
                    w[i] <= w[i] + ((e * x[i]) >>> 12);

                y_out <= Y >>> 8;
                out_valid <= 1;
            end
        end
    end

endmodule
