module lms_16tap (
    input  logic clk, rst,
    input  logic in_valid,
    input  logic signed [15:0] x_in,
    input  logic signed [15:0] d_in,
    output logic out_valid,
    output logic signed [15:0] y_out
);


    logic signed [15:0] x[0:15];
    logic signed [15:0] w[0:15];


    logic signed [31:0] y_reg[0:15];
    logic signed [31:0] sum_reg[0:7];
    logic signed [31:0] sum1_reg[0:3];
    logic signed [31:0] sum2_reg[0:1];

    logic signed [31:0] sum_final_reg;
    logic signed [32:0] e_reg;


    logic signed [15:0] d_delay[0:5];

    logic signed [15:0] x_delay[0:15][0:5];

    logic valid_pipe[0:6];

    integer i, j;

    always_ff @(posedge clk or posedge rst) begin

        if (rst) begin

            for (i=0; i<16; i++) begin
                x[i] <= 0;
                w[i] <= 0;
                y_reg[i] <= 0;

                for (j=0; j<6; j++) begin
                    x_delay[i][j] <= 0;
                end
            end

            for (i=0; i<8; i++)
                sum_reg[i] <= 0;

            for (i=0; i<4; i++)
                sum1_reg[i] <= 0;

            for (i=0; i<2; i++)
                sum2_reg[i] <= 0;

            sum_final_reg <= 0;
            e_reg         <= 0;
            y_out         <= 0;
            out_valid     <= 0;

            for (i=0; i<6; i++)
                d_delay[i] <= 0;

            for (i=0; i<7; i++)
                valid_pipe[i] <= 0;

        end
        else begin


            valid_pipe[0] <= in_valid;

            for (i=1; i<7; i++) begin
                valid_pipe[i] <= valid_pipe[i-1];
            end

            out_valid <= valid_pipe[6];


            if (in_valid) begin

                for (i=15; i>0; i--) begin
                    x[i] <= x[i-1];
                end

                x[0] <= x_in;
            end


            for (i=0; i<16; i++) begin
                y_reg[i] <= w[i] * x[i];
            end


            for (i=0; i<8; i++) begin
                sum_reg[i] <= y_reg[2*i] + y_reg[2*i+1];
            end


            for (i=0; i<4; i++) begin
                sum1_reg[i] <= sum_reg[2*i] + sum_reg[2*i+1];
            end


            for (i=0; i<2; i++) begin
                sum2_reg[i] <= sum1_reg[2*i] + sum1_reg[2*i+1];
            end

            sum_final_reg <= sum2_reg[0] + sum2_reg[1];

            e_reg <= d_delay[5]
                     - ((sum2_reg[0] + sum2_reg[1]) >>> 8);

            y_out <= sum_final_reg >>> 8;


            d_delay[0] <= d_in;

            for (i=1; i<6; i++) begin
                d_delay[i] <= d_delay[i-1];
            end


            for (i=0; i<16; i++) begin

                x_delay[i][0] <= x[i];

                for (j=1; j<6; j++) begin
                    x_delay[i][j] <= x_delay[i][j-1];
                end
            end


            if (valid_pipe[6]) begin

                for (i=0; i<16; i++) begin

                    w[i] <= w[i]
                          + ((e_reg * x_delay[i][5]) >>> 12);

                end
            end
        end
    end

endmodule


module lms_i2s_top (
    input  logic clk,       
    input  logic rst,      
    input  logic sclk,     
    input  logic ws,       
    input  logic sd_x_in,   
    input  logic sd_d_in,   
    output logic sd_y_out   
);

    logic signed [15:0] x_in_parallel;
    logic signed [15:0] d_in_parallel;
    logic signed [15:0] y_out_parallel;

    logic rx_x_valid;
    logic rx_d_valid;
    logic lms_in_valid;
    logic lms_out_valid;

    assign lms_in_valid = rx_x_valid && rx_d_valid;

    i2s_rx u_i2s_rx_x (
        .clk          (clk),
        .rst          (rst),
        .sclk         (sclk),
        .ws           (ws),
        .sd_in        (sd_x_in),
        .sample_out   (x_in_parallel),
        .sample_valid (rx_x_valid)
    );

    i2s_rx u_i2s_rx_d (
        .clk          (clk),
        .rst          (rst),
        .sclk         (sclk),
        .ws           (ws),
        .sd_in        (sd_d_in),
        .sample_out   (d_in_parallel),
        .sample_valid (rx_d_valid)
    );

    lms_16tap u_lms_filter (
        .clk       (clk),
        .rst       (rst),
        .in_valid  (lms_in_valid),
        .x_in      (x_in_parallel),
        .d_in      (d_in_parallel),
        .out_valid (lms_out_valid),
        .y_out     (y_out_parallel)
    );

    i2s_tx u_i2s_tx_y (
        .clk          (clk),
        .rst          (rst),
        .sclk         (sclk),
        .ws           (ws),
        .sd_out       (sd_y_out),
        .sample_in    (y_out_parallel),
        .sample_valid (lms_out_valid)
    );

endmodule

