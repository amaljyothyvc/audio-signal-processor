module i2s_tx (
    input  logic        clk,
    input  logic        rst,
    input  logic        sclk,
    input  logic        ws,
    output logic        sd_out,
    input  logic signed [15:0] sample_in,
    input  logic        sample_valid
);

    logic sclk_d1, sclk_d2;
    logic ws_d1, ws_d2;
    logic [15:0] tx_shift_reg;
    logic        sclk_falling_edge;
    logic        ws_falling_edge;

    always_ff @(posedge clk or posedge rst) begin
        if (rst) begin
            sclk_d1 <= 1'b0;
            sclk_d2 <= 1'b0;
            ws_d1   <= 1'b0;
            ws_d2   <= 1'b0;
        end else begin
            sclk_d1 <= sclk;
            sclk_d2 <= sclk_d1;
            ws_d1   <= ws;
            ws_d2   <= ws_d1;
        end
    end

    assign sclk_falling_edge = (sclk_d1 == 1'b0) && (sclk_d2 == 1'b1);
    assign ws_falling_edge   = (ws_d1 == 1'b0)   && (ws_d2 == 1'b1);

    always_ff @(posedge clk or posedge rst) begin
        if (rst) begin
            tx_shift_reg <= '0;
            sd_out       <= 1'b0;
        end else begin
            if (sample_valid) begin
                tx_shift_reg <= sample_in;
            end else if (sclk_falling_edge) begin
                if (ws_falling_edge) begin
                    sd_out <= tx_shift_reg[15];
                end else begin
                    sd_out       <= tx_shift_reg[15];
                    tx_shift_reg <= {tx_shift_reg[14:0], 1'b0};
                end
            end
        end
    end

endmodule


