
module audio_top (
    input  logic        clk,
    input  logic        rst,
    input  logic        in_valid,
    input  logic [63:0] in_data,
    input  logic [3:0]  volume,
    output logic        out_valid,
    output logic [63:0] out_data
);

    logic sample_valid;
    logic signed [15:0] x_sample, d_sample;
    logic lms_valid;
    logic signed [15:0] y_out, e_out, vol_out;

    unpacker u_unpack (
        .clk(clk), .rst(rst),
        .in_valid(in_valid),
        .in_data(in_data),
        .sample_valid(sample_valid),
        .x_out(x_sample),
        .d_out(d_sample)
    );

    lms_16tap u_lms (
        .clk(clk), .rst(rst),
        .in_valid(sample_valid),
        .x_in(x_sample),
        .d_in(d_sample),
        .out_valid(lms_valid),
        .y_out(y_out)
    );

    error_block u_err (
        .clk(clk),
        .in_valid(lms_valid),
        .d_in(d_sample),
        .y_in(y_out),
        .e_out(e_out)
    );

    volume_control u_vol (
        .clk(clk),
        .in_valid(lms_valid),
        .sample_in(e_out),
        .volume(volume),
        .sample_out(vol_out)
    );

    packer u_pack (
        .clk(clk), .rst(rst),
        .in_valid(lms_valid),
        .sample_in(vol_out),
        .out_valid(out_valid),
        .out_data(out_data)
    );

endmodule


`timescale 1ns/1ps

--
module i2s_rx (
    input  logic        clk,
    input  logic        rst,
    input  logic        sclk,
    input  logic        ws,
    input  logic        sd_in,
    output logic signed [15:0] sample_out,
    output logic        sample_valid
);

    logic sclk_d1, sclk_d2;
    logic ws_d1, ws_d2;
    logic [15:0] shift_reg;
    logic [4:0]  bit_count;
    logic        ws_falling_edge;
    logic        sclk_rising_edge;
    always_ff @(posedge clk or posedge rst) begin
        if (rst) begin
            sclk_d1 <= 1'b0;
            sclk_d2 <= 1'b0;
            ws_d1   <= 1'b0;
            ws_d2   <= 1'b0;
        end else begin
            sclk_d1 <= sclk;
            sclk_d2 <= sclk_d1;
            ws_d1   <= ws;
            ws_d2   <= ws_d1;
        end
    end

    assign sclk_rising_edge = (sclk_d1 == 1'b1) && (sclk_d2 == 1'b0);
    assign ws_falling_edge  = (ws_d1 == 1'b0)   && (ws_d2 == 1'b1); // Left Channel Start

    always_ff @(posedge clk or posedge rst) begin
        if (rst) begin
            shift_reg    <= '0;
            bit_count    <= '0;
            sample_out   <= '0;
            sample_valid <= 1'b0;
        end else begin
            sample_valid <= 1'b0;

            if (sclk_rising_edge) begin
                if (ws_falling_edge) begin
                    bit_count <= 5'd16; // 16-bit payload extraction
                end else if (bit_count > 0) begin
                    shift_reg <= {shift_reg[14:0], sd_in};
                    bit_count <= bit_count - 1'b1;

                    if (bit_count == 5'd1) begin
                        sample_out   <= {shift_reg[14:0], sd_in};
                        sample_valid <= 1'b1; // Trigger LMS processing
                    end
                end
            end
        end
    end

endmodule


